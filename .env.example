# ── Sanity (catalogue + orders) ──────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only token with Editor rights (sanity.io/manage → API → Tokens).
# Used to record paid orders, deduct stock and power order tracking.
# Never prefix it NEXT_PUBLIC_. Without it, orders live in Paystack only.
SANITY_API_READ_WRITE_TOKEN=

# ── Paystack ──────────────────────────────────────────────────────────
# Use sk_test_… until you have tested the full flow end-to-end.
PAYSTACK_SECRET_KEY=

# ── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Paid-order alerts ─────────────────────────────────────────────────
# Email (Resend — resend.com). Works immediately for alerts to the address you
# signed up to Resend with. Customer receipts need a domain verified in Resend;
# set EMAIL_FROM to an address on that domain to switch them on.
RESEND_API_KEY=
EMAIL_FROM=
ORDER_ALERT_EMAIL=

# WhatsApp (CallMeBot — free, unofficial). Each number activates once and gets
# its own key; format: number:key,number:key  e.g. 0558793259:123456,0243735752:654321
CALLMEBOT_RECIPIENTS=
